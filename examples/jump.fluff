# Jump over the cactus! Press ▲ or space.
canvas 600, 300
background "lightskyblue"
color "sandybrown"
rect 0, 250, 600, 50

player = sprite "🦖", 80, 225
cactus = sprite "🌵", 650, 225
speed_y = 0
points = 0

repeat forever
  # jump only when standing on the ground
  if (key "up" or key "space") and player.y >= 225
    speed_y = -14
  end

  # gravity pulls down a little more every frame
  speed_y += 0.8
  player.y += speed_y
  if player.y > 225
    player.y = 225
    speed_y = 0
  end

  cactus.x -= 6 + points / 5
  if cactus.x < -30
    cactus.x = 650
    points += 1
  end

  show "Points: {points}"
  if player touches cactus
    show "Ouch! You jumped {points} times."
    stop
  end
end
